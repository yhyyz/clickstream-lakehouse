{
  "family": "clickstream-task-optimized",
  "taskRoleArn": "arn:aws:iam::305996241648:role/ecsTaskRole-clickstream",
  "executionRoleArn": "arn:aws:iam::305996241648:role/ecsTaskExecutionRole-clickstream",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "8192",
  "memory": "16384",
  "containerDefinitions": [
    {
      "name": "clickstream-container",
      "image": "305996241648.dkr.ecr.us-east-1.amazonaws.com/clickstream-openresty-lua-msk-optimized:latest",
      "cpu": 6144,
      "memory": 12288,
      "portMappings": [
        {
          "containerPort": 8802,
          "hostPort": 8802,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "KAFKA_BROKER_HOST",
          "value": "boot-uaw.msklogstream.oee1gg.c16.kafka.us-east-1.amazonaws.com"
        },
        {
          "name": "KAFKA_BROKER_PORT",
          "value": "9092"
        },
        {
          "name": "SEND_S3_ONLY",
          "value": "enable"
        }
      ],
      "mountPoints": [
        {
          "sourceVolume": "clickstream-ebs-volume",
          "containerPath": "/opt/app/collect-app/logs",
          "readOnly": false
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/clickstream-optimized",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    },
    {
      "name": "fluent-bit",
      "image": "305996241648.dkr.ecr.us-east-1.amazonaws.com/custom-fluent-bit-optimized:latest",
      "cpu": 2048,
      "memory": 4096,
      "essential": false,
      "mountPoints": [
        {
          "sourceVolume": "clickstream-ebs-volume",
          "containerPath": "/opt/app/collect-app/logs",
          "readOnly": true
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/clickstream-optimized",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "fluent-bit"
        }
      }
    }
  ],
  "volumes": [
    {
      "name": "clickstream-ebs-volume",
      "configuredAtLaunch": true
    }
  ]
}
